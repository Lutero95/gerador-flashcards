# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA coloque chaves reais neste arquivo: ele é versionado.

# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui

# Configurações do Mercado Pago
# Access Token obtido em: https://www.mercadopago.com.br/developers/panel/credentials
# Use o Access Token de TESTE para desenvolvimento
MERCADOPAGO_ACCESS_TOKEN=coloque_seu_access_token_aqui
MERCADOPAGO_PUBLIC_KEY=coloque_sua_public_key_aqui

# Chave secreta para validação de webhooks
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app/{seu_app_id}/webhooks
MERCADOPAGO_WEBHOOK_SECRET=coloque_seu_webhook_secret_aqui

# Anti-abuso (Fase 4)
# Cloudflare Turnstile (gratuito): https://dash.cloudflare.com/?to=/:account/turnstile
# Obrigatório em produção. Para testar localmente, as chaves de teste da Cloudflare sempre aprovam:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA  TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Prévias grátis por dia: por navegador e por IP (o IP é guardado só como hash)
PREVIAS_POR_DIA=3
PREVIAS_POR_DIA_IP=15
# Teto de custo das prévias grátis por dia, em US$ (a compra direta continua disponível)
ORCAMENTO_PREVIAS_USD_DIA=0.50
# Preço dos modelos (US$ por milhão de tokens [entrada, saída]); confira na página oficial do Gemini
# PRECOS_MODELOS_USD={"gemini-flash-lite-latest": [0.30, 2.50], "gemini-flash-latest": [0.75, 3.75]}
CACHE_PREVIA_HORAS=24
DIAS_PEDIDO_NAO_PAGO=7
# Requisições por minuto, por IP
LIMITE_CRIAR_PEDIDO_MIN=10
LIMITE_CONSULTA_MIN=60
LIMITE_ACOES_MIN=30
# Segredo da rota /tarefas/limpeza (a Vercel envia no Cron diário configurado em vercel.json)
CRON_SECRET=

# Desenvolvimento local: FLASK_DEBUG=1 liga o modo debug (nunca em rede aberta)
# FLASK_DEBUG=1

# Ambiente: development (padrão) ou production.
# Em production a aplicação não sobe sem SECRET_KEY, DATABASE_URL (Postgres) e credenciais reais.
APP_ENV=development

# Banco. Local: SQLite (padrão). Produção: Postgres gratuito (Neon ou Supabase).
# DATABASE_URL=postgresql://usuario:senha@host/banco
DATABASE_URL=sqlite:///local.db

# Chave para assinar cookies. Obrigatória em produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Provedor de pagamento: fake (padrão em desenvolvimento, sem dinheiro) ou mercadopago.
# PAYMENT_PROVIDER=mercadopago

# Endereço público do site (https://...). Em produção é obrigatório: vira a notification_url do Pix.
# URL_PUBLICA=https://seu-site.vercel.app

# Modelos do Gemini (trocáveis sem mexer no código)
# Prévia grátis: modelo barato. Geração paga: modelo intermediário. O *_FALLBACK entra quando o
# principal falha ou está sobrecarregado (503), na mesma requisição.
MODELO_PREVIA=gemini-flash-lite-latest
MODELO_PREVIA_FALLBACK=gemini-flash-latest
MODELO_GERACAO=gemini-flash-latest
MODELO_GERACAO_FALLBACK=gemini-flash-lite-latest
# Orçamento de raciocínio (cobrado como saída). -1 = padrão do modelo.
THINKING_PREVIA=0
THINKING_GERACAO=512

# Limites
MAX_CARDS=500
TAMANHO_PREVIA=5
TAMANHO_LOTE=40
# Prazo de IA por requisição de lote (a função da Vercel tem 60 s)
TEMPO_MAX_LOTE_S=45
# Abaixo desta fração do pedido, a geração falha e o cliente escolhe reembolso total ou parcial
ENTREGA_MINIMA=0.9
LIMITE_CARACTERES_MATERIAL=200000
LIMITE_CARACTERES_PREVIA=30000
PIX_EXPIRACAO_MIN=30
DIAS_RETENCAO_PEDIDO=30
